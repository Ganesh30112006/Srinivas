# Production environment for all four backend services.
# setup.sh copies this to /etc/smartclass/backend.env (mode 0640, root:smartclass) and fills the
# placeholders. Never commit the real file.
ENVIRONMENT=production

DATABASE_URL=postgresql+asyncpg://smartclass:__DB_PASSWORD__@127.0.0.1:5432/smartclass
REDIS_URL=redis://127.0.0.1:6379/0

# Audio chunks: set S3_BUCKET to store them in S3 (the EC2 instance role grants access);
# leave it empty to keep them on the instance's disk under AUDIO_DIR.
AUDIO_DIR=/var/lib/smartclass/audio
S3_BUCKET=
AWS_REGION=ap-south-1

# HTTPS is terminated by Caddy, so cookies are always Secure in production.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
CORS_ORIGINS=["https://__SITE_ADDRESS__"]

DEVICE_GAIN=4.0
DEVICE_VAD_ENABLED=true
STOP_FALLBACK_MINUTES=10

# ASR (D11): CPU int8 is the baseline; pick ASR_MODEL from the eval/ benchmark.
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LIVE_INTERVAL_S=1.5
ASR_LANGUAGE_MODE=fixed
# faster-whisper downloads models here on first start.
HF_HOME=/var/lib/smartclass/models

# Amazon Bedrock (D9). Must be a model or inference profile enabled in this account/region.
# Several LLMs may be listed, best first: each request falls back to the next model when one is
# refused or its reply fails validation. Tested in ap-south-1 (2026-11-24): Claude Opus 4.6 is the
# best model there; Claude and Cohere are sold through AWS Marketplace and need a valid payment
# method on the account, while Amazon Nova Lite works on any account. Embeddings never fall back
# (lines and questions must share one vector space); use amazon.titan-embed-text-v2:0 where Cohere
# is unavailable, and re-run notes generation after changing the embedding model.
BEDROCK_LLM_MODEL_ID=global.anthropic.claude-opus-4-6-v1,apac.amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=cohere.embed-multilingual-v3
LIVE_KEY_TERMS_INTERVAL_S=180

# Delete recorded lecture audio this many days after the lecture ends (DPDP Act 2023). Transcripts
# and notes are kept. 0 keeps audio forever. Applied daily by smartclass-retention.timer.
AUDIO_RETENTION_DAYS=0
